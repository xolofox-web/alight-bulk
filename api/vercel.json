{
  "crons": [
    {
      "path": "/api/cron-reset",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron-queue",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron-report",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}