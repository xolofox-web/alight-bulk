{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/proxy.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron-reset",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron-queue",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron-report",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}